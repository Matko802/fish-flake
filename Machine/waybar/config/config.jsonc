{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "mango/workspaces",
        "mango/layout"
    ],

    "modules-center": [
        "mango/window"
    ],

    "modules-right": [
        "tray",
        "mango/language",
        "pulseaudio",
        "network#ethernet",
        "network#wifi",
        "cpu",
        "memory",
        "battery",
        "clock"
    ],

  "mango/workspaces": {
      "format": "{icon}",
      "hide-empty": true,
      "on-click": "activate",
      "on-click-right": "toggle",
      "overview-label": "OVERVIEW"
  },

    "mango/layout": {
      "format": "{}"
  },

  "mango/language": {
  "format": "{short}"
  },

    "tray": {
        "icon-size": 14,
        "spacing": 12
    },
    
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%Y-%m-%d}",
        "interval": 1
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {}%"
    },
    
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄{icon} {capacity}%",
        "format-plugged": "{capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "network#wifi": {
    "interface": "wlan*",
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": false,
    "on-click": "nm-connection-editor"
    },

    "network#ethernet": {
    "interface": "enp*",
    "format-ethernet": "",
    "tooltip": false,
    "on-click": "nm-connection-editor"
    },

    "mango/window": {
    "format": "{}",
	"icon-size": 20,
    "max-length": 30,
    "ellipsis": true
  },
    
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯{icon} {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󱡒",
            "headset": "󰋋",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
