#!/usr/bin/env bash
set -euo pipefail
export LC_NUMERIC=C

api="${OPENCODE_UPDATE_API:-https://opencode.ai/update/api/latest/cli/npm}"
registry_base="${OPENCODE_REGISTRY:-https://registry.npmjs.org}"
home="${OPENCODE_HOME:-${HOME:?}/.opencode}"
bin="$home/bin/opencode"
version_file="$home/version"
loader="${OPENCODE_NIX_LOADER:-}"

usage() {
  cat >&2 <<'EOF'
usage: opencode-manager [command]

commands:
  update [version]  install the latest or a specific version
  install <version> install a specific version
  status            show installed and latest versions
  version           print the installed version
  path              print the installed binary path
  help              show this help
EOF
}

say() {
  printf 'opencode-manager: %s\n' "$*" >&2
}

latest_version() {
  curl -fsSL --connect-timeout 2 --max-time 5 "$api" 2>/dev/null |
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

package_scope() {
  local scope
  scope="$(curl -fsSL --connect-timeout 2 --max-time 5 "$api" 2>/dev/null |
    sed -n 's/.*"package"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed 's|/cli$||')"
  printf '%s\n' "${scope:-@opencode}"
}

target_name() {
  local arch target
  case "$(uname -m)" in
    x86_64|amd64) arch=x64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) say "unsupported architecture $(uname -m)"; return 1 ;;
  esac
  target="linux-$arch"
  if [ "$arch" = x64 ] && ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
    target="$target-baseline"
  fi
  if [ -f /etc/alpine-release ]; then
    target="$target-musl"
  fi
  printf '%s\n' "$target"
}

installed_version() {
  [ -x "$bin" ] || return 1
  if [ -s "$version_file" ]; then
    head -n1 "$version_file"
    return 0
  fi
  local detected
  detected="$("$bin" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1 || true)"
  [ -n "$detected" ] || return 1
  mkdir -p "$home"
  printf '%s\n' "$detected" > "$version_file" 2>/dev/null || true
  printf '%s\n' "$detected"
}

version_gt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

install_version() {
  local version="${1:-}" scope target url tmp new
  version="${version#v}"
  case "$version" in
    ""|*[!0-9A-Za-z.+-]*) say "invalid version '$version'"; return 1 ;;
  esac
  scope="$(package_scope)"
  target="$(target_name)" || return 1
  url="${registry_base}/${scope}/cli-${target}/-/cli-${target}-${version}.tgz"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/opencode.XXXXXX")"
  say "installing opencode ${version}"
  if ! curl -fsSL --connect-timeout 10 -o "$tmp/opencode.tgz" "$url"; then
    say "failed to download ${url}"
    rm -rf "$tmp"
    return 1
  fi
  if ! tar -xzf "$tmp/opencode.tgz" -C "$tmp"; then
    say "failed to extract ${url}"
    rm -rf "$tmp"
    return 1
  fi
  new="$tmp/package/bin/opencode"
  if [ ! -f "$new" ]; then
    say "${url} did not contain package/bin/opencode"
    rm -rf "$tmp"
    return 1
  fi
  chmod 755 "$new"
  if ! "$new" --version >/dev/null 2>&1 &&
    [ -n "$loader" ] && command -v patchelf >/dev/null 2>&1; then
    if ! patchelf --set-interpreter "$loader" "$new"; then
      say "failed to patch the dynamic loader"
      rm -rf "$tmp"
      return 1
    fi
  fi
  if ! "$new" --version >/dev/null 2>&1; then
    say "downloaded opencode ${version} does not run"
    rm -rf "$tmp"
    return 1
  fi
  mkdir -p "$home/bin"
  if ! install -m755 "$new" "$home/bin/.opencode.new"; then
    say "failed to write to ${home}/bin"
    rm -rf "$tmp"
    return 1
  fi
  mv -f "$home/bin/.opencode.new" "$bin"
  printf '%s\n' "$version" > "$version_file"
  rm -rf "$tmp"
  say "opencode ${version} installed in ${home}"
}

if [ -n "${OPENCODE_MANAGER_MODE:-}" ]; then
  cmd="${1:-update}"
  case "$cmd" in
    update|install)
      target="${2:-latest}"
      if [ "$target" = latest ]; then
        target="$(latest_version)"
        [ -n "$target" ] || { say "could not determine the latest version"; exit 1; }
      fi
      install_version "$target"
      ;;
    status)
      printf 'home: %s\n' "$home"
      printf 'installed: %s\n' "$(installed_version || echo not-installed)"
      printf 'latest: %s\n' "$(latest_version || echo unknown)"
      ;;
    version)
      installed_version || { printf 'not installed\n'; exit 1; }
      ;;
    path)
      printf '%s\n' "$bin"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
  exit 0
fi

installed="$(installed_version || true)"

if [ -z "$installed" ]; then
  latest="$(latest_version)"
  if [ -z "$latest" ]; then
    say "opencode is not installed and the latest version could not be determined"
    exit 1
  fi
  install_version "$latest"
  installed="$latest"
fi

if [ -t 0 ] && [ -t 2 ] && [ -z "${OPENCODE_NO_UPDATE:-}" ]; then
  latest="$(latest_version || true)"
  if [ -n "$latest" ] && version_gt "$latest" "$installed"; then
    printf 'opencode %s is available (installed %s). Update? [y/N] ' "$latest" "$installed" >&2
    answer="" read -r answer || answer=""
    case "$answer" in
      [yY]*) install_version "$latest" || true ;;
    esac
  fi
fi

export OPENCODE_DISABLE_AUTOUPDATE=1
exec "$bin" "$@"
